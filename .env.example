# AWS Credentials — replace with your own values
# 1. Create an IAM user with AmazonBedrockFullAccess permission
# 2. Generate an access key for that user
# 3. Paste the values below
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# Bedrock Models
# Make sure these models are accessible in your AWS account & region
BEDROCK_GENERATION_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Project Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
VECTOR_STORE_PATH=./data/vector_store